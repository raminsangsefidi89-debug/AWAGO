# ============================================================
# AWAGO configuration — copy this file to .env and edit.
# Every variable is optional; the defaults shown below are used
# when the variable is absent. Secrets (API tokens) live ONLY in
# this file, never in source code or git.
# ============================================================

# --- Server ---------------------------------------------------
# Bind address. Default is localhost only (safe).
# To reach the app from a phone on your home network use HOST=0.0.0.0
# (SECURITY WARNING: anyone on your network can then open the app
# and trigger data collection / training jobs).
HOST=127.0.0.1
PORT=8000

# Open the default browser automatically when the launcher starts.
OPEN_BROWSER=true

# --- Database -------------------------------------------------
# Default: SQLite under data/. Any SQLAlchemy URL works, e.g. PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/awago
DATABASE_URL=sqlite:///data/awago.db

# --- Data sources ---------------------------------------------
# demo : always use reproducible synthetic demo data (works offline).
# live : use the real provider (Frankfurter / ECB reference rates).
# auto : try the real provider first, fall back to demo if it fails
#        or a required key is missing (when FALLBACK_TO_DEMO=true).
DATA_MODE=demo

# Provider used when DATA_MODE=live or auto: frankfurter | demo
DATA_PROVIDER=frankfurter

# If the real provider fails at runtime, fall back to demo data
# (true) or return a clear error (false).
FALLBACK_TO_DEMO=true

# Free Frankfurter API (no key required). Override only if the
# upstream endpoint changes. This endpoint could NOT be verified
# from the build environment; see README "Data sources".
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Outbound HTTP behaviour for data providers.
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=3

# --- Market data ----------------------------------------------
# Currency pairs managed by the app (comma separated, BASE/QUOTE).
DEFAULT_PAIRS=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD,USD/CAD,NZD/USD,EUR/GBP,EUR/JPY,USD/TRY

# How many calendar days of daily history to keep/seed.
HISTORY_DAYS=1095

# Fixed seed for demo data generation (same seed => same data).
DEMO_SEED=42

# --- Forecasting ----------------------------------------------
# Comma separated horizons in days.
FORECAST_HORIZONS=1,7,30

# Prediction interval width for forecast bands (0.90 = 90%).
PREDICTION_INTERVAL_LEVEL=0.90

# Train lightweight models automatically after first seeding so the
# dashboard shows forecasts right away. Training is still never run
# on plain server startup — only in the launcher/CLI/API jobs.
AUTO_TRAIN_ON_SEED=true

# --- Security -------------------------------------------------
# Optional token protecting the job endpoints (POST /jobs/*).
# Job endpoints are always allowed from localhost; a valid token
# additionally allows remote calls (e.g. from another device).
# API_TOKEN=change-me-to-a-long-random-string

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
